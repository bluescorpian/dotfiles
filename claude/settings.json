{
	"attribution": {
		"commit": "",
		"pr": ""
	},
	"permissions": {
		"allow": [
			"WebSearch",
			"Bash(npx next build:*)",
			"WebFetch(domain:clerk.com)",
			"Bash(find:*)",
			"Bash(git -C /home/harry-smartstation/smart-station/repos/wedded-world diff)",
			"Bash(git -C /home/harry-smartstation/smart-station/repos/wedded-world log --oneline -5)",
			"mcp__ide__getDiagnostics",
			"mcp__claude_ai_Atlassian__getAccessibleAtlassianResources",
			"mcp__claude_ai_Atlassian__fetch",
			"mcp__plugin_atlassian_atlassian__getAccessibleAtlassianResources",
			"mcp__plugin_atlassian_atlassian__getConfluencePage",
			"Bash(ls:*)",
			"Bash(git:*)",
			"Bash(journalctl:*)",
			"Bash(echo:*)",
			"Bash(systemctl:*)",
			"Bash(grep:*)",
			"Bash(wc:*)",
			"Bash(git diff:*)",
			"Bash(pnpm type-check:*)",
			"Bash(pnpm prisma generate)",
			"mcp__context7__resolve-library-id",
			"mcp__context7__query-docs"
		],
		"defaultMode": "auto"
	},
	"enabledPlugins": {
		"atlassian@claude-plugins-official": true,
		"code-review@claude-plugins-official": true,
		"typescript-lsp@claude-plugins-official": false,
		"commit-commands@claude-plugins-official": true,
		"claude-md-management@claude-plugins-official": true,
		"frontend-design@claude-plugins-official": true,
		"worktrunk@worktrunk": true,
		"code-simplifier@claude-plugins-official": true,
		"feature-dev@claude-plugins-official": true,
		"playwright@claude-plugins-official": true
	},
	"extraKnownMarketplaces": {
		"worktrunk": {
			"source": {
				"source": "github",
				"repo": "max-sixty/worktrunk"
			}
		}
	},
	"statusLine": {
		"type": "command",
		"command": "$HOME/.claude/statusline.sh",
		"padding": 0
	},
	"hooks": {
		"Notification": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/notify.sh"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "mcp__plugin_claude-code-home-manager_claude-conversation-search__.*",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/conversation-search-uuid-hint.sh"
					}
				]
			}
		]
	},
	"preferredNotifChannel": "terminal_bell",
	"autoCompactEnabled": false,
	"skipAutoPermissionPrompt": true,
	"voiceEnabled": true,
	"tui": "fullscreen",
	"skipWorkflowUsageWarning": true
}
