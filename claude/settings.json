{
	"attribution": {
		"commit": "",
		"pr": ""
	},
	"env": {
		"CLAUDE_CODE_ENABLE_CFC": "1"
	},
	"permissions": {
		"defaultMode": "auto",
		"ask": [
			"Bash(git push --force*)",
			"Bash(git push -f*)",
			"Bash(gh pr create*)",
			"Bash(gh pr merge*)",
			"Bash(gh pr comment*)",
			"Bash(gh pr review*)",
			"Bash(tofu apply*)",
			"Bash(terraform apply*)",
			"Bash(vps-deploy*)",
			"Bash(/home/shared/dotfiles/scripts/vps-deploy.sh*)",
			"mcp__plugin_atlassian_atlassian__addCommentToJiraIssue",
			"mcp__claude_ai_Atlassian__addCommentToJiraIssue",
			"mcp__plugin_atlassian_atlassian__createConfluenceFooterComment",
			"mcp__plugin_atlassian_atlassian__createConfluenceInlineComment",
			"mcp__claude_ai_Atlassian__createConfluenceFooterComment",
			"mcp__claude_ai_Atlassian__createConfluenceInlineComment"
		]
	},
	"enabledPlugins": {
		"atlassian@claude-plugins-official": false,
		"code-review@claude-plugins-official": true,
		"typescript-lsp@claude-plugins-official": false,
		"commit-commands@claude-plugins-official": true,
		"claude-md-management@claude-plugins-official": true,
		"frontend-design@claude-plugins-official": true,
		"worktrunk@worktrunk": true,
		"code-simplifier@claude-plugins-official": false,
		"feature-dev@claude-plugins-official": false,
		"playwright@claude-plugins-official": true,
		"firecrawl@claude-plugins-official": false
	},
	"extraKnownMarketplaces": {
		"worktrunk": {
			"source": {
				"source": "github",
				"repo": "max-sixty/worktrunk"
			}
		}
	},
	"statusLine": {
		"type": "command",
		"command": "$HOME/.claude/statusline.sh",
		"padding": 0
	},
	"hooks": {
		"Notification": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/notify.sh"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "mcp__plugin_claude-code-home-manager_claude-conversation-search__.*",
				"hooks": [
					{
						"type": "command",
						"command": "$HOME/.claude/hooks/conversation-search-uuid-hint.sh"
					}
				]
			}
		]
	},
	"preferredNotifChannel": "terminal_bell",
	"autoCompactEnabled": true,
	"autoCompactWindow": 400000,
	"skipAutoPermissionPrompt": true,
	"voiceEnabled": true,
	"tui": "fullscreen",
	"skipWorkflowUsageWarning": true
}
